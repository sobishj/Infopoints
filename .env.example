# ============================== InfoPoint configuration ==============================
# Copy to .env (scripts/start.ps1 does this on first run and fills in the secrets).

# desktop = single machine (launcher manages Bionic), server = shared service
APP_MODE=desktop
APP_PORT=8765
APP_SECRET_KEY=change-me
INTERNAL_TOKEN=change-me

# ---------------------------------------------------------------- Document folders
# Roots the app may read from, in HOST terms, comma-separated. Each root is mounted
# read-only into the containers at /roots/<alias>. After changing this, re-run
# scripts/start.ps1 (it regenerates docker-compose.roots.yml and restarts the services).
ALLOWED_DOC_ROOTS=C:\
# Folder offered on first run; used when the user skips folder selection.
# Empty = the system Downloads folder (filled in by scripts/start.ps1).
DEFAULT_DOC_FOLDER=

# ---------------------------------------------------------------- Accounts
INITIAL_ADMIN_USER=admin
INITIAL_ADMIN_PASSWORD=change-me
# Desktop single-user mode: log in automatically as the initial admin.
# Only safe because the app port is bound to 127.0.0.1.
AUTO_LOGIN=true

# ---------------------------------------------------------------- Local LLM (Bionic)
# Containers reach the host through host.docker.internal.
QWEN_BASE_URL=http://host.docker.internal:1234/v1
QWEN_MODEL_NAME=qwen2.5-1.5b-instruct
QWEN_API_KEY=
QWEN_CONTEXT_LENGTH=32768
LLM_MAX_CONCURRENCY=2

# ---------------------------------------------------------------- Bionic lifecycle (desktop)
MANAGE_BIONIC=true
BIONIC_START_CMD="%LOCALAPPDATA%\Programs\Bionic\Bionic.exe"
BIONIC_STOP_CMD=
BIONIC_HEALTH_URL=http://localhost:1234/v1/models
BIONIC_START_TIMEOUT=180

# ---------------------------------------------------------------- Indexing
EMBEDDING_MODEL=BAAI/bge-m3
EMBED_THREADS=6
OCR_LANGS=eng
FOLDER_POLL_SECONDS=20
RESCAN_INTERVAL_SECONDS=300
STABILITY_SECONDS=10
DOC_LANE_SLOTS=2

# ---------------------------------------------------------------- Retrieval
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATES=40
MIN_VECTOR_SIMILARITY=0.45
